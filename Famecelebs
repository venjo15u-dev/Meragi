<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="FameCelebs - دنیای سلبریتی‌ها، اخبار و سبک زندگی ستاره‌ها">
<meta name="author" content="FameCelebs">
<meta name="theme-color" content="#0F1B33">
<title>FameCelebs | دنیای سلبریتی‌ها</title>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='22' fill='%237B1E2B'/><text x='50' y='70' font-size='58' text-anchor='middle' fill='%23D4AF7A' font-family='sans-serif' font-weight='bold'>F</text></svg>">
<link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<style>
  :root{
    --maroon:#7B1E2B;
    --maroon-dark:#5A141F;
    --maroon-light:#A8324A;
    --midnight:#0F1B33;
    --midnight-2:#16264A;
    --midnight-3:#1E3358;
    --gray:#8A8A8A;
    --gray-dark:#2B2F36;
    --gray-light:#F2F3F5;
    --gray-mid:#E1E3E8;
    --white:#FFFFFF;
    --gold:#D4AF7A;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;scroll-padding-top:90px;}
  body{font-family:'Vazirmatn',sans-serif;background:var(--gray-light);color:var(--gray-dark);line-height:1.9;overflow-x:hidden;}
  a{text-decoration:none;color:inherit;}
  img{max-width:100%;display:block;}
  .container{max-width:1200px;margin:0 auto;padding:0 24px;}

  /* هدر */
  header{position:fixed;top:0;right:0;left:0;z-index:1000;background:rgba(15,27,51,0.96);backdrop-filter:blur(12px);border-bottom:2px solid var(--maroon);}
  .nav{display:flex;align-items:center;justify-content:space-between;padding:16px 0;}
  .logo{font-size:1.5rem;font-weight:900;color:var(--white);display:flex;align-items:center;gap:10px;}
  .logo-mark{width:40px;height:40px;border-radius:12px;background:linear-gradient(135deg,var(--maroon),var(--maroon-light));display:flex;align-items:center;justify-content:center;font-size:1.3rem;color:var(--gold);box-shadow:0 6px 16px rgba(123,30,43,0.5);font-weight:900;}
  .logo span{color:var(--gold);}
  .nav-links{display:flex;gap:30px;list-style:none;}
  .nav-links a{color:#c9d0dc;font-weight:500;font-size:0.95rem;transition:0.3s;position:relative;padding:4px 0;}
  .nav-links a::after{content:'';position:absolute;bottom:0;right:0;width:0;height:2px;background:var(--gold);transition:0.3s;}
  .nav-links a:hover{color:var(--white);}
  .nav-links a:hover::after{width:100%;}
  .btn{display:inline-block;padding:11px 28px;border-radius:50px;font-weight:600;font-size:0.9rem;cursor:pointer;transition:0.3s;border:none;font-family:inherit;text-align:center;}
  .btn-primary{background:linear-gradient(135deg,var(--maroon),var(--maroon-light));color:var(--white);box-shadow:0 6px 18px rgba(123,30,43,0.45);}
  .btn-primary:hover{transform:translateY(-3px);box-shadow:0 10px 26px rgba(123,30,43,0.65);}
  .btn-gold{background:linear-gradient(135deg,var(--gold),#b8925f);color:var(--midnight);font-weight:700;box-shadow:0 6px 18px rgba(212,175,122,0.4);}
  .btn-gold:hover{transform:translateY(-3px);box-shadow:0 10px 26px rgba(212,175,122,0.6);}
  .btn-outline{background:transparent;color:var(--white);border:2px solid rgba(255,255,255,0.35);}
  .btn-outline:hover{border-color:var(--gold);color:var(--gold);}

  /* Hero */
  .hero{min-height:100vh;display:flex;align-items:center;position:relative;padding:140px 0 90px;color:var(--white);background:radial-gradient(circle at 80% 20%,rgba(123,30,43,0.45),transparent 55%),radial-gradient(circle at 15% 85%,rgba(30,51,88,0.7),transparent 50%),linear-gradient(135deg,var(--midnight),var(--midnight-2) 60%,var(--midnight-3));overflow:hidden;}
  .hero::before{content:'';position:absolute;top:-80px;left:-80px;width:340px;height:340px;border-radius:50%;background:radial-gradient(circle,rgba(212,175,122,0.18),transparent 70%);}
  .hero-grid{display:grid;grid-template-columns:1.1fr 0.9fr;gap:50px;align-items:center;position:relative;z-index:2;}
  .hero-badge{display:inline-block;background:rgba(212,175,122,0.12);border:1px solid var(--gold);color:var(--gold);padding:7px 18px;border-radius:50px;font-size:0.85rem;margin-bottom:24px;}
  .hero h1{font-size:3rem;font-weight:900;line-height:1.35;margin-bottom:20px;}
  .hero h1 .hl{background:linear-gradient(135deg,var(--gold),#f0d3a8);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;}
  .hero p{font-size:1.1rem;color:#c9d0dc;margin-bottom:34px;font-weight:300;max-width:540px;}
  .hero-btns{display:flex;gap:16px;flex-wrap:wrap;}
  .hero-stats{display:flex;gap:34px;margin-top:44px;flex-wrap:wrap;}
  .hero-stat h3{font-size:1.7rem;font-weight:800;color:var(--gold);}
  .hero-stat span{font-size:0.85rem;color:#a8b1c2;}
  .hero-visual{display:flex;justify-content:center;}
  .brand-card{width:100%;max-width:400px;border-radius:28px;background:linear-gradient(160deg,rgba(255,255,255,0.08),rgba(255,255,255,0.02));border:1px solid rgba(212,175,122,0.25);padding:40px 30px;backdrop-filter:blur(10px);box-shadow:0 30px 70px rgba(0,0,0,0.45);text-align:center;}
  .brand-logo{width:110px;height:110px;margin:0 auto 22px;border-radius:28px;background:linear-gradient(135deg,var(--maroon),var(--maroon-light));display:flex;align-items:center;justify-content:center;font-size:3rem;color:var(--gold);font-weight:900;box-shadow:0 16px 40px rgba(123,30,43,0.5);border:2px solid rgba(212,175,122,0.4);}
  .brand-card h3{font-size:1.5rem;color:var(--white);margin-bottom:6px;}
  .brand-card p{font-size:0.9rem;color:#a8b1c2;}
  .brand-social{display:flex;justify-content:center;gap:12px;margin-top:20px;}
  .brand-social a{width:40px;height:40px;border-radius:12px;background:rgba(212,175,122,0.12);border:1px solid rgba(212,175,122,0.3);display:flex;align-items:center;justify-content:center;color:var(--gold);transition:0.3s;font-size:1rem;}
  .brand-social a:hover{background:var(--maroon);color:#fff;transform:translateY(-3px);}

  /* بخش عمومی */
  section{padding:100px 0;}
  .section-title{text-align:center;margin-bottom:64px;}
  .section-title .kicker{display:inline-block;color:var(--maroon);font-weight:700;font-size:0.85rem;letter-spacing:1px;margin-bottom:10px;}
  .section-title h2{font-size:2.3rem;font-weight:900;color:var(--gray-dark);margin-bottom:12px;line-height:1.4;}
  .section-title h2 .hl{color:var(--maroon);}
  .section-title p{color:var(--gray);font-size:1.05rem;max-width:640px;margin:0 auto;}

  /* درباره */
  .about{background:var(--white);}
  .about-grid{display:grid;grid-template-columns:0.9fr 1.1fr;gap:60px;align-items:center;}
  .about-visual{position:relative;}
  .about-img{width:100%;height:460px;border-radius:28px;background:linear-gradient(160deg,rgba(15,27,51,0.2),rgba(123,30,43,0.3)),url('https://images.unsplash.com/photo-1492684223066-81342ee5ff30?w=800') center/cover;border:1px solid var(--gray-mid);box-shadow:0 24px 50px rgba(15,27,51,0.18);}
  .about-badge{position:absolute;bottom:-24px;left:-24px;background:linear-gradient(135deg,var(--maroon),var(--maroon-light));color:#fff;padding:18px 26px;border-radius:20px;box-shadow:0 16px 34px rgba(123,30,43,0.4);text-align:center;}
  .about-badge strong{display:block;font-size:1.2rem;font-weight:900;}
  .about-badge span{font-size:0.8rem;opacity:0.9;}
  .about-content h3{font-size:1.8rem;font-weight:800;margin-bottom:18px;}
  .about-content h3 .hl{color:var(--maroon);}
  .about-content p{color:#5a6068;margin-bottom:16px;font-size:1rem;}
  .about-list{list-style:none;margin-top:22px;}
  .about-list li{display:flex;align-items:flex-start;gap:12px;margin-bottom:14px;font-size:0.97rem;color:var(--gray-dark);}
  .about-list li .tick{flex-shrink:0;width:26px;height:26px;border-radius:50%;background:rgba(123,30,43,0.1);color:var(--maroon);display:flex;align-items:center;justify-content:center;font-weight:900;font-size:0.85rem;margin-top:2px;}
  .about-cta{margin-top:26px;display:flex;gap:14px;flex-wrap:wrap;}

  /* خدمات */
  .services{background:linear-gradient(160deg,var(--midnight),var(--midnight-2));color:var(--white);position:relative;overflow:hidden;}
  .services::before{content:'';position:absolute;top:-120px;right:-120px;width:420px;height:420px;border-radius:50%;background:radial-gradient(circle,rgba(123,30,43,0.35),transparent 70%);}
  .services .section-title h2{color:var(--white);}
  .services .section-title h2 .hl{color:var(--gold);}
  .services .section-title p{color:#a8b1c2;}
  .services-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:28px;position:relative;z-index:2;}
  .service-card{background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:24px;padding:36px 30px;transition:0.4s;position:relative;overflow:hidden;}
  .service-card::before{content:'';position:absolute;top:0;right:0;left:0;height:3px;background:linear-gradient(to left,var(--maroon),var(--gold));transform:scaleX(0);transition:0.4s;}
  .service-card:hover{transform:translateY(-10px);background:rgba(255,255,255,0.09);border-color:rgba(212,175,122,0.4);box-shadow:0 26px 50px rgba(0,0,0,0.4);}
  .service-card:hover::before{transform:scaleX(1);}
  .service-icon{width:64px;height:64px;border-radius:18px;background:linear-gradient(135deg,var(--maroon),var(--maroon-light));display:flex;align-items:center;justify-content:center;font-size:1.6rem;margin-bottom:22px;box-shadow:0 10px 22px rgba(123,30,43,0.4);}
  .service-card h3{font-size:1.3rem;margin-bottom:10px;font-weight:800;}
  .service-card > p{color:#a8b1c2;font-size:0.93rem;margin-bottom:20px;}
  .service-meta{display:flex;justify-content:space-between;align-items:center;padding-top:18px;border-top:1px solid rgba(255,255,255,0.1);font-size:0.85rem;color:#c9d0dc;}
  .service-meta .price{color:var(--gold);font-weight:800;font-size:1rem;}

  /* مزایا */
  .features{background:var(--gray-light);}
  .features-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:26px;}
  .feature-card{background:var(--white);border-radius:22px;padding:38px 28px;text-align:center;transition:0.4s;border:1px solid transparent;}
  .feature-card:hover{transform:translateY(-8px);box-shadow:0 22px 45px rgba(15,27,51,0.12);border-color:rgba(123,30,43,0.15);}
  .feature-icon{width:70px;height:70px;margin:0 auto 22px;background:linear-gradient(135deg,var(--midnight),var(--midnight-3));border-radius:20px;display:flex;align-items:center;justify-content:center;font-size:1.8rem;color:var(--gold);box-shadow:0 10px 22px rgba(15,27,51,0.25);}
  .feature-card h3{font-size:1.15rem;margin-bottom:10px;font-weight:800;}
  .feature-card p{color:var(--gray);font-size:0.92rem;}

  /* آمار */
  .stats{background:linear-gradient(135deg,var(--maroon-dark),var(--maroon));color:var(--white);padding:70px 0;}
  .stats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:30px;text-align:center;}
  .stat-item h3{font-size:2.6rem;font-weight:900;color:var(--gold);line-height:1;}
  .stat-item span{font-size:0.95rem;color:#f0dde0;margin-top:8px;display:block;}

  /* نظرات */
  .testimonials{background:var(--white);}
  .testi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:26px;}
  .testi-card{background:var(--gray-light);border-radius:22px;padding:32px 28px;transition:0.4s;border-right:4px solid var(--maroon);}
  .testi-card:hover{transform:translateY(-6px);box-shadow:0 18px 40px rgba(15,27,51,0.12);}
  .testi-stars{color:var(--gold);font-size:1rem;margin-bottom:14px;letter-spacing:2px;}
  .testi-card p{font-size:0.95rem;color:#4a5058;margin-bottom:20px;font-style:italic;}
  .testi-author{display:flex;align-items:center;gap:12px;}
  .testi-avatar{width:46px;height:46px;border-radius:50%;background:linear-gradient(135deg,var(--maroon),var(--midnight));display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800;}
  .testi-author strong{display:block;font-size:0.95rem;}
  .testi-author span{font-size:0.8rem;color:var(--gray);}

  /* FAQ */
  .faq{background:var(--gray-light);}
  .faq-list{max-width:820px;margin:0 auto;display:flex;flex-direction:column;gap:16px;}
  .faq-item{background:var(--white);border-radius:18px;padding:24px 28px;border:1px solid var(--gray-mid);transition:0.3s;}
  .faq-item:hover{border-color:rgba(123,30,43,0.3);box-shadow:0 10px 26px rgba(15,27,51,0.08);}
  .faq-item h3{font-size:1.05rem;font-weight:800;color:var(--midnight);margin-bottom:8px;display:flex;align-items:center;gap:10px;}
  .faq-item h3::before{content:'؟';width:26px;height:26px;flex-shrink:0;border-radius:50%;background:rgba(123,30,43,0.1);color:var(--maroon);display:flex;align-items:center;justify-content:center;font-weight:900;}
  .faq-item p{color:#5a6068;font-size:0.93rem;padding-right:36px;}

  /* تماس */
  .contact{background:linear-gradient(135deg,var(--midnight),var(--midnight-2));color:var(--white);}
  .contact .section-title h2{color:var(--white);}
  .contact .section-title h2 .hl{color:var(--gold);}
  .contact .section-title p{color:#a8b1c2;}
  .contact-wrapper{display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:center;max-width:1000px;margin:0 auto;}
  .contact-info h3{font-size:1.6rem;margin-bottom:18px;}
  .contact-info p{color:#c9d0dc;margin-bottom:26px;}
  .contact-item{display:flex;align-items:center;gap:14px;margin-bottom:18px;font-size:0.95rem;color:#e0e0e0;}
  .contact-item .ic{width:44px;height:44px;border-radius:12px;background:rgba(212,175,122,0.12);border:1px solid rgba(212,175,122,0.3);display:flex;align-items:center;justify-content:center;font-size:1.1rem;color:var(--gold);}
  .contact-item a:hover{color:var(--gold);}
  .contact-tg{display:inline-flex;align-items:center;gap:10px;margin-top:8px;padding:12px 24px;border-radius:50px;background:linear-gradient(135deg,#229ED9,#1a7fb0);color:#fff;font-weight:700;transition:0.3s;box-shadow:0 8px 20px rgba(34,158,217,0.4);}
  .contact-tg:hover{transform:translateY(-3px);box-shadow:0 12px 28px rgba(34,158,217,0.6);}
  form{background:rgba(255,255,255,0.06);padding:36px;border-radius:24px;border:1px solid rgba(255,255,255,0.12);backdrop-filter:blur(8px);}
  .form-group{margin-bottom:18px;}
  form label{display:block;margin-bottom:8px;font-size:0.9rem;color:#e0e0e0;}
  form input,form textarea{width:100%;padding:13px 16px;border-radius:12px;border:1px solid rgba(255,255,255,0.18);background:rgba(255,255,255,0.07);color:var(--white);font-family:inherit;font-size:0.95rem;transition:0.3s;}
  form input::placeholder,form textarea::placeholder{color:#8a94a6;}
  form input:focus,form textarea:focus{outline:none;border-color:var(--gold);background:rgba(255,255,255,0.12);}
  form textarea{resize:vertical;min-height:110px;}
  form .btn-primary{width:100%;margin-top:6px;padding:14px;font-size:1rem;}

  /* فوتر */
  footer{background:#0B1424;color:#9aa4b5;padding:54px 0 26px;text-align:center;}
  .footer-logo{font-size:1.5rem;font-weight:900;color:var(--white);margin-bottom:10px;}
  .footer-logo span{color:var(--gold);}
  .footer-social{display:flex;justify-content:center;gap:14px;margin:22px 0;}
  .footer-social a{width:42px;height:42px;border-radius:50%;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);display:flex;align-items:center;justify-content:center;transition:0.3s;font-size:1rem;}
  .footer-social a:hover{background:var(--maroon);border-color:var(--maroon);transform:translateY(-3px);}
  footer .copy{border-top:1px solid rgba(255,255,255,0.08);padding-top:22px;margin-top:22px;font-size:0.82rem;color:#6d7688;}

  /* ریسپانسیو */
  @media(max-width:900px){
    .hero-grid,.about-grid,.contact-wrapper{grid-template-columns:1fr;}
    .hero{padding:130px 0 70px;}
    .hero-visual{order:-1;}
    .about-visual{max-width:420px;margin:0 auto;}
  }
  @media(max-width:820px){
    .nav-links{display:none;}
    .hero h1{font-size:2.1rem;}
    section{padding:70px 0;}
    .section-title h2{font-size:1.7rem;}
    .about-badge{left:10px;bottom:-18px;padding:14px 20px;}
    .about-img{height:360px;}
  }
</style>
</head>
